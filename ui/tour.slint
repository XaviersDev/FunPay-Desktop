import { Theme } from "theme.slint";
import { St, Api } from "globals.slint";

// Обучение: затемнение с окошком вокруг нужной кнопки и Рыцарь FunPay с подсказкой.
export component Tour inherits Rectangle {
    property <bool> has-target: St.tour-target != "" && St.tour-seen == St.tour-target;
    property <length> pad: 6px;
    // цели сообщают координаты окна, а мы начинаемся под шапкой
    property <length> rx: St.tour-x - root.absolute-position.x - pad;
    property <length> ry: St.tour-y - root.absolute-position.y - pad;
    property <length> rw: St.tour-w + pad * 2;
    property <length> rh: St.tour-h + pad * 2;
    property <length> bw: min(380px, root.width - 24px);
    property <bool> above: root.ry + root.rh / 2 > root.height / 2;
    property <length> bx: root.side ? min(root.width - root.bw - 12px, root.rx + root.rw + 16px) : root.has-target ? max(12px, min(root.width - root.bw - 12px, root.rx + root.rw / 2 - root.bw / 2)) : (root.width - root.bw) / 2;
    property <length> by: root.side ? max(12px, min(root.height - card.height - 12px, root.ry + root.rh - card.height)) : !root.has-target ? (root.height - card.height) / 2
        : root.above ? max(40px, root.ry - card.height - 16px)
        : min(root.height - card.height - 12px, root.ry + root.rh + 16px);
    property <color> dim: St.tour == "tplsave" ? #00000040 : #000000A0;
    // на экране входа не мешаем другим способам входа
    property <bool> block: St.tour != "login" && St.tour != "tplsave";
    // шаблон можно править, поэтому подсказка сбоку от кнопки, а не поверх полей
    property <bool> side: St.tour == "tplsave" && root.has-target;

    // за действиями пользователя следим здесь, Rust двигает шаги дальше
    property <bool> so: St.settings-open;
    changed so => { if (self.so) { Api.tour-event("settings"); } }
    property <bool> to: St.tpl-open;
    changed to => { if (self.to) { Api.tour-event("tpl-open"); } }
    property <bool> te: St.tpl-editing;
    changed te => { if (self.te) { Api.tour-event("tpl-editing"); } }

    // затемнение вокруг цели, сама цель остаётся нажимаемой
    if !root.has-target: Rectangle {
        background: root.dim;
        if root.block: TouchArea { }
    }
    if root.has-target: Rectangle {
        x: 0;
        y: 0;
        width: root.width;
        height: max(0px, root.ry);
        background: root.dim;
        if root.block: TouchArea { }
    }
    if root.has-target: Rectangle {
        x: 0;
        y: root.ry + root.rh;
        width: root.width;
        height: max(0px, root.height - root.ry - root.rh);
        background: root.dim;
        if root.block: TouchArea { }
    }
    if root.has-target: Rectangle {
        x: 0;
        y: root.ry;
        width: max(0px, root.rx);
        height: root.rh;
        background: root.dim;
        if root.block: TouchArea { }
    }
    if root.has-target: Rectangle {
        x: root.rx + root.rw;
        y: root.ry;
        width: max(0px, root.width - root.rx - root.rw);
        height: root.rh;
        background: root.dim;
        if root.block: TouchArea { }
    }
    // пульсирующая рамка вокруг цели
    if root.has-target: Rectangle {
        property <float> p: mod(animation-tick() / 1ms, 1400) / 1400;
        x: root.rx - self.p * 5px;
        y: root.ry - self.p * 5px;
        width: root.rw + self.p * 10px;
        height: root.rh + self.p * 10px;
        border-radius: 12px + self.p * 4px;
        border-width: 2.5px;
        border-color: Theme.accent.with-alpha(1 - self.p * 0.8);
    }

    card := Rectangle {
        x: root.bx;
        y: root.by;
        width: root.bw;
        height: cl.preferred-height;
        animate x, y { duration: 260ms; easing: cubic-bezier(0.2, 0.9, 0.25, 1.0); }
        border-radius: 16px;
        background: Theme.panel;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000060;
        TouchArea { }
        cl := HorizontalLayout {
            padding: 16px;
            spacing: 14px;
            // маскот
            VerticalLayout {
                alignment: start;
                Rectangle {
                    width: 62px;
                    height: 62px;
                    border-radius: 31px;
                    clip: true;
                    background: #15171C;
                    border-width: 2px;
                    border-color: Theme.accent;
                    Image { source: @image-url("icons/knight.png"); width: 62px; height: 62px; image-fit: cover; }
                }
            }
            VerticalLayout {
                spacing: 7px;
                horizontal-stretch: 1;
                HorizontalLayout {
                    spacing: 9px;
                    if St.tour-n > 0: Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 12px;
                        background: Theme.accent;
                        Text { text: St.tour-n; color: Theme.on-accent; font-size: 13px; font-weight: 700; }
                    }
                    Text {
                        text: St.tour-title;
                        color: Theme.ink;
                        font-size: 16px;
                        font-weight: 700;
                        vertical-alignment: center;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }
                Text {
                    text: St.tour-text;
                    color: Theme.muted;
                    font-size: 13.5px;
                    wrap: word-wrap;
                    width: root.bw - 32px - 62px - 14px;
                }
                HorizontalLayout {
                    spacing: 10px;
                    padding-top: 4px;
                    Text {
                        text: St.tour == "done" ? "" : "Пропустить";
                        color: Theme.faint;
                        font-size: 13px;
                        vertical-alignment: center;
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { Api.tour-skip(); }
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    if St.tour-next != "": Rectangle {
                        height: 34px;
                        width: nl.preferred-width + 30px;
                        border-radius: 17px;
                        background: na.has-hover ? Theme.accent.brighter(0.08) : Theme.accent;
                        nl := Text { text: St.tour-next; color: Theme.on-accent; font-size: 13.5px; font-weight: 650; }
                        na := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { Api.tour-next(); }
                        }
                    }
                    if St.tour-next == "": Text {
                        text: St.tour == "ai" ? "смотри…" : "жду, пока нажмёшь";
                        color: Theme.accent;
                        font-size: 12.5px;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
